# Server
PORT=3000

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=your_meta_access_token
PHONE_NUMBER_ID=your_phone_number_id

# Webhook verification (developer-defined; must match Meta webhook settings)
VERIFY_TOKEN=your_custom_verify_token

# Meta App Secret. When set, inbound webhooks are verified with HMAC-SHA256
# (X-Hub-Signature-256). REQUIRED unless the app runs with the 'dev' Spring
# profile (SPRING_PROFILES_ACTIVE=dev): the app fails fast at startup if this is
# blank and the dev profile is not active. Leave blank ONLY for local dev demos.
APP_SECRET=

# Optional: Graph API base URL + version (defaults shown)
GRAPH_API_BASE_URL=https://graph.facebook.com
GRAPH_API_VERSION=v20.0

# Optional: webhook rate limiting (fixed window). Generous defaults so local
# demos are unaffected; only abnormal bursts get HTTP 429.
RATE_LIMIT_PERMIT=300
RATE_LIMIT_WINDOW_SECONDS=60
