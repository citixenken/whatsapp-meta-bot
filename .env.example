# Server
PORT=3000

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=your_meta_access_token
PHONE_NUMBER_ID=your_phone_number_id

# Webhook verification (developer-defined; must match Meta webhook settings)
VERIFY_TOKEN=your_custom_verify_token

# Optional: Meta App Secret. When set, inbound webhooks are verified with
# HMAC-SHA256 (X-Hub-Signature-256). Leave blank during early MVP testing to
# keep verification disabled.
APP_SECRET=

# Optional: Graph API version (defaults to v20.0 when unset)
GRAPH_API_VERSION=v20.0
