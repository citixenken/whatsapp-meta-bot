# .gitignore

# Dependencies
node_modules/

# Environment variables
.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/

# Build outputs
dist/
build/

# OS generated files
.DS_Store
Thumbs.db

# IDE / Editor folders
.vscode/
.idea/

# Mac system files
.AppleDouble
.LSOverride

# Linux temp files
*~

# ngrok
.ngrok2/