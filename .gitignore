# .gitignore

# .NET build outputs
bin/
obj/
out/
publish/

# .NET user-specific files
*.user
*.suo
*.userprefs

# Environment variables
.env

# Logs
logs/
*.log

# Coverage directory
coverage/
*.coverage
*.coveragexml

# Build outputs
dist/
build/

# OS generated files
.DS_Store
Thumbs.db

# IDE / Editor folders
.vs/
.vscode/
.idea/

# Mac system files
.AppleDouble
.LSOverride

# Linux temp files
*~

# ngrok
.ngrok2/